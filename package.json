{
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "site": "tsc --noEmit -p site && tsx site/build.ts && eleventy --config=site/eleventy.config.js",
    "site:dev": "tsx site/build.ts && eleventy --config=site/eleventy.config.js --serve --port=8124",
    "start": "tsx build.ts && extensions-cli run",
    "package": "tsc --noEmit && tsx build.ts --production && tsx pack.ts"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./extensions-sdk-1.0.0-beta.0/ableton-extensions-sdk-1.0.0-beta.0.tgz"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@ableton-extensions/cli": "file:./extensions-sdk-1.0.0-beta.0/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^25.9.2",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
