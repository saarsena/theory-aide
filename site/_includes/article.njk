---
layout: base.njk
---
{# Encyclopedia article layout. Wikipedia-shaped, no community edits:
   heading, plain-English lead, Contents box (once there are 3+ sections),
   body, See also, category line, and the empty comments mount point. #}
<article>
  {%- set spinePos = page.fileSlug | spineInfo %}
  {%- set clusterPos = false %}
  {%- if not spinePos %}{% set clusterPos = page.fileSlug | clusterInfo %}{% endif %}
  {% if spinePos %}
  <div class="track-bar">Track 1 · article {{ spinePos.index }} of {{ spinePos.total }}</div>
  {% elif clusterPos %}
  <div class="track-bar track-2">Track 2 · <a href="/tracks/">{{ clusterPos.name }}</a>{% if clusterPos.total > 1 %} · article {{ clusterPos.index }} of {{ clusterPos.total }}{% endif %}</div>
  {% else %}
  <div class="track-bar track-2">Track 2 · depth beyond the spine</div>
  {% endif %}

  <h1>{{ heading or title }}</h1>

  {% if lead %}<p class="lede">{{ lead | wikilinks | safe }}</p>{% endif %}

  {{ content | toc | safe }}

  {{ content | wikilinks | safe }}

  {% if mountain %}
  <aside class="mountain">
    <strong>A mountain, not a page.</strong>
    {{ mountain | wikilinks | safe }}
  </aside>
  {% endif %}

  {% if spinePos %}
  <nav class="spine-nav" aria-label="Track 1 navigation">
    {% if spinePos.prev %}<a href="/concepts/{{ spinePos.prev.slug }}/">← {{ spinePos.prev.title }}</a>{% else %}<span></span>{% endif %}
    {% if spinePos.next %}<a href="/concepts/{{ spinePos.next.slug }}/">{{ spinePos.next.title }} →</a>{% endif %}
  </nav>
  {% elif clusterPos and (clusterPos.prev or clusterPos.next) %}
  <nav class="spine-nav" aria-label="{{ clusterPos.name }} navigation">
    {% if clusterPos.prev %}<a href="/concepts/{{ clusterPos.prev.slug }}/">← {{ clusterPos.prev.title }}</a>{% else %}<span></span>{% endif %}
    {% if clusterPos.next %}<a href="/concepts/{{ clusterPos.next.slug }}/">{{ clusterPos.next.title }} →</a>{% endif %}
  </nav>
  {% endif %}

  {% if see_also %}
  <section class="see-also">
    <h2>See also</h2>
    <ul>
      {%- for item in see_also %}
      <li>{{ ("[[" + item + "]]") | wikilinks | safe }}</li>
      {%- endfor %}
    </ul>
  </section>
  {% endif %}

  {% if references %}
  <section class="references">
    <h2>References</h2>
    <ol>
      {%- for ref in references %}
      <li>{{ ref.author }}{% if ref.year %} ({{ ref.year }}){% endif %}.
        <em>{% if ref.url %}<a href="{{ ref.url }}">{{ ref.title }}</a>{% else %}{{ ref.title }}{% endif %}</em>{% if ref.source %}. {{ ref.source }}{% endif %}.</li>
      {%- endfor %}
    </ol>
  </section>
  {% endif %}

  {% if category %}
  <div class="article-meta">Category: {{ category }}</div>
  {% endif %}

  {# Comments mount point. Empty and invisible today. When comments arrive,
     a client-side script will find this section by id and fill it; comment
     threads key on the page URL, which is why article slugs are permanent.
     Do not rename or remove this id. #}
  <section class="comments-slot" id="comments"></section>
</article>
