# Copy this file to .env and fill in your values.

# Path to the Ableton Live extension host (required by extensions-cli)
# Windows: C:\ProgramData\Ableton\Live 12 Beta\Program\ExtensionHost\ExtensionHostNodeModule.node
# macOS:   /Applications/Ableton Live 12 Beta.app/Contents/Frameworks/ExtensionHostNodeModule.node
EXTENSION_HOST_PATH=
